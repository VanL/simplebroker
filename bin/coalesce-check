#!/usr/bin/env python3
"""Evidence trail for the coalescing layer's session-start check.

The run log's source_sha cues are the layer's retrieval contract, and
until this gate they were unchecked prose — agent-guidance's 2026-07-28
field audit found cues that resolve locally but not in published
history. This tool:

  1. verifies every `<sha>` cited in docs/coalescing.md resolves through one
     `git cat-file --batch-check` process;
  2. verifies every `git show <sha>:<path>` cue's path exists at that
     SHA;
  3. checks each SHA against the published remote (origin), reporting
     `local-only pin` where it does not resolve there — a cue that
     survives only on one machine is a claim the world cannot verify;
  4. derives the lessons-tier count with this repository's documented
     derivation so a session-start check can quote real numbers.

Read-only by construction. Exit 1 only on an unresolvable local cue
(a broken retrieval contract); local-only pins and count reports are
informational — publication discipline is the owner's call. This tool is
an evidence trail, not a second recipe: `docs/coalescing.md` remains
authoritative for the plans and unindexed tiers.

Adopted from agent-guidance @ `e42762c` via retired plan
2026-07-28-propagate-guidance-delta-wave-plan (source `54fa706`; see
`docs/plans/README.md`).

On a shallow clone the SHA-resolution and retrieval-cue legs cannot
be truthful (history is absent), so they are SKIPPED loudly with
exit 0 — a false BROKEN is as invalid as a silent pass. Enforcement
requires full history. (Adopted from agent-theory @ 0423923.)
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE = REPO_ROOT / "docs" / "coalescing.md"

SHA_RE = re.compile(r"`([0-9a-f]{7,40})`")
CUE_RE = re.compile(r"git show ([0-9a-f]{7,40}):([A-Za-z0-9_./-]+)")

# Foreign attribution is a REPORTING aid, never a resolution mechanism: it
# names foreign repositories this repo's own citations refer to, makes no
# filesystem assumption, and resolves nothing. Never include this repo's own
# name ("simplebroker") here.
FOREIGN_MARKERS = (
    "agent-theory",
    "agent-guidance",
    "mm",
    "weft",
    "taut",
    "backstitch",
    "engram",
)
FOREIGN_ATTRIBUTION_RE = re.compile(
    r"\b("
    + "|".join(re.escape(m) for m in FOREIGN_MARKERS)
    + r")\s*(?:@\s*(?:`[0-9a-f]{7,40}`\s*\(\s*via\s*)?|(?:commit|pin|sha|source)\s+)$",
    re.IGNORECASE,
)

# Opt-in local convenience, unset by default. A sibling working copy is an
# environment fact, not a portability claim: anything found this way is
# reported separately and never counted as verified.
SIBLING_ROOT = os.environ.get("COALESCE_SIBLING_ROOT")


def git(
    *args: str,
    repo: Path | None = None,
    stdin: str | None = None,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo or REPO_ROOT), *args],
        capture_output=True,
        text=True,
        input=stdin,
        check=False,
    )


def attributed_repo(text: str, pos: int) -> str | None:
    """Return explicit foreign-repo attribution immediately preceding ``pos``."""
    window = text[max(0, pos - 80) : pos]
    clause = re.split(r"[\r\n|;]", window)[-1]
    match = FOREIGN_ATTRIBUTION_RE.search(clause)
    return match.group(1).lower() if match else None


def batch_object_info(
    expressions: set[str], *, repo: Path | None = None
) -> dict[str, tuple[str, str] | None]:
    """Resolve every object expression through one long-lived Git process."""
    ordered = sorted(expressions)
    if not ordered:
        return {}
    result = git(
        "cat-file",
        "--batch-check=%(objectname) %(objecttype)",
        repo=repo,
        stdin="\n".join(ordered) + "\n",
    )
    if result.returncode != 0:
        return dict.fromkeys(ordered)
    lines = result.stdout.splitlines()
    if len(lines) != len(ordered):
        return dict.fromkeys(ordered)
    info: dict[str, tuple[str, str] | None] = {}
    for index, expression in enumerate(ordered):
        line = lines[index]
        parts = line.rsplit(" ", 1)
        info[expression] = (
            (parts[0], parts[1])
            if len(parts) == 2 and parts[1] in {"blob", "commit", "tag", "tree"}
            else None
        )
    return info


def reachable_commits(remote_ref: str | None, *, repo: Path | None = None) -> set[str]:
    """Return the commits published through the default remote branch."""
    if remote_ref is None:
        return set()
    result = git("rev-list", remote_ref, repo=repo)
    if result.returncode != 0:
        return set()
    return set(result.stdout.splitlines())


def retained_ref_commits(*, repo: Path | None = None) -> set[str]:
    """Return commits reachable from HEAD or retained branch/tag/remote refs."""
    result = git("rev-list", "HEAD", "--branches", "--tags", "--remotes", repo=repo)
    if result.returncode != 0:
        return set()
    return set(result.stdout.splitlines())


def in_local_checkout(sha: str) -> str | None:
    """Opt-in only (COALESCE_SIBLING_ROOT). Environment-dependent by nature,
    so the caller reports it as such and never as verification."""
    if not SIBLING_ROOT:
        return None
    root = Path(SIBLING_ROOT)
    if not root.is_dir():
        return None
    for cand in sorted(root.iterdir()):
        if (cand / ".git").exists() and git(
            "cat-file", "-e", f"{sha}^{{commit}}", repo=cand
        ).returncode == 0:
            return cand.name
    return None


def resolve_remote_ref() -> str | None:
    """Resolve the default remote branch via origin/HEAD, falling back to origin/main."""
    sym = git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD")
    if sym.returncode == 0 and sym.stdout.strip():
        cand = sym.stdout.strip()
        if git("rev-parse", "--verify", cand).returncode == 0:
            return cand
    for fallback in ("origin/main", "origin/HEAD"):
        if git("rev-parse", "--verify", fallback).returncode == 0:
            return fallback
    return None


def _parse_retired_plan_row(line: str) -> tuple[str, str] | None:
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    if len(cells) < 2 or set(cells[0]) <= {"-", " "}:
        return None
    plan_cell = cells[0].strip("`").strip()
    sha_match = SHA_RE.search(cells[-1])
    if not plan_cell or not sha_match:
        return None
    rel = (
        plan_cell if plan_cell.startswith("docs/plans/") else f"docs/plans/{plan_cell}"
    )
    if not rel.endswith(".md"):
        rel = f"{rel}.md"
    return (sha_match.group(1), rel)


def retired_plan_cues() -> list[tuple[str, str]]:
    """Extract (sha, repo_relative_plan_path) from ## Retired Plans in docs/plans/README.md."""
    readme = REPO_ROOT / "docs" / "plans" / "README.md"
    if not readme.is_file():
        return []
    in_retired = False
    in_table = False
    results: list[tuple[str, str]] = []
    for line in readme.read_text(errors="replace").splitlines():
        if line.startswith("## "):
            in_retired = line.strip() == "## Retired Plans"
            in_table = False
        elif in_retired and line.startswith("| Plan"):
            in_table = True
        elif in_table and not line.startswith("|"):
            in_table = False
        elif in_table:
            parsed = _parse_retired_plan_row(line)
            if parsed is not None:
                results.append(parsed)
    return results


def _classify_local_commit(
    sha: str,
    full_sha: str,
    *,
    retained_commits: set[str],
    remote_ref: str | None,
    remote_commits: set[str],
    allow_local_only: bool,
    local_only: list[str],
    broken: list[str],
) -> None:
    if full_sha not in retained_commits:
        if allow_local_only:
            local_only.append(sha)
        else:
            broken.append(
                f"`{sha}` resolves only to an unreachable loose Git object "
                "(not reachable from HEAD or any retained ref)"
            )
        return
    if remote_ref and full_sha not in remote_commits:
        local_only.append(sha)


def classify_sha_claims(
    text: str,
    *,
    remote_ref: str | None,
    object_info: dict[str, tuple[str, str] | None],
    remote_commits: set[str],
    retained_commits: set[str],
    allow_local_only: bool = False,
) -> tuple[set[str], list[str], list[str], list[str]]:
    """Classify each distinct cited commit without changing retrieval truth."""

    sha_hits = ((match.group(1), match.start()) for match in SHA_RE.finditer(text))
    broken: list[str] = []
    local_only: list[str] = []
    foreign: list[str] = []
    seen: set[str] = set()
    for sha, pos in sha_hits:
        if sha in seen:
            continue
        seen.add(sha)
        commit = object_info.get(f"{sha}^{{commit}}")
        if commit is not None and commit[1] == "commit":
            _classify_local_commit(
                sha,
                commit[0],
                retained_commits=retained_commits,
                remote_ref=remote_ref,
                remote_commits=remote_commits,
                allow_local_only=allow_local_only,
                local_only=local_only,
                broken=broken,
            )
            continue
        who = attributed_repo(text, pos)
        if who:
            extra = in_local_checkout(sha)
            foreign.append(
                f"{sha} @ {who}"
                + (f" (present in a local checkout of {extra})" if extra else "")
            )
        else:
            broken.append(
                f"`{sha}` resolves nowhere here and names no "
                "repository — a cue must say where it is retrievable"
            )
    return seen, broken, local_only, foreign


def broken_retrieval_cues(
    cues: list[tuple[str, str]],
    *,
    seen: set[str],
    local_only: list[str],
    remote_ref: str | None,
    object_info: dict[str, tuple[str, str] | None],
    remote_commits: set[str],
    retained_commits: set[str],
    allow_local_only: bool = False,
) -> list[str]:
    """Return every explicit git-show or retired-plan cue that cannot be retrieved locally."""

    broken: list[str] = []
    for sha, path in cues:
        commit = object_info.get(f"{sha}^{{commit}}")
        target = object_info.get(f"{sha}:{path}")
        if commit is None or commit[1] != "commit" or target is None:
            broken.append(f"cue `git show {sha}:{path}` does not resolve here")
            continue
        if commit[0] not in retained_commits and not allow_local_only:
            broken.append(
                f"cue `git show {sha}:{path}` relies on unreachable loose commit `{sha}`"
            )
            continue
        if sha not in seen:
            seen.add(sha)
            if commit[0] not in retained_commits or (
                remote_ref and commit[0] not in remote_commits
            ):
                local_only.append(sha)
    return broken


def count_lesson_entries() -> int:
    """Derive the lessons tier with the repository's documented recipe."""

    # Lessons-tier derivation. This repository's documented ledger form is a
    # dated bullet WITH a colon (docs/lessons.md, "New ledger entries must use
    # this form"); the docs/coalescing.md recipe greps the same pattern.
    lessons = REPO_ROOT / "docs" / "lessons.md"
    if not lessons.is_file():
        return 0
    return len(
        re.findall(
            r"^- 20[0-9]{2}-[0-9]{2}-[0-9]{2}:",
            lessons.read_text(encoding="utf-8"),
            re.MULTILINE,
        )
    )


def report_results(
    *,
    claim_count: int,
    cue_count: int,
    retired_cue_count: int,
    lesson_count: int,
    remote_ref: str | None,
    broken: list[str],
    local_only: list[str],
    foreign: list[str],
) -> int:
    """Print the evidence trail and return its truthful command status."""

    print(
        f"coalesce-check: {claim_count} SHA claim(s) "
        f"({len(foreign)} foreign claim(s)), {cue_count} retrieval cue(s) "
        f"({retired_cue_count} retired-plan cue(s)); "
        f"lessons dated entries: {lesson_count}"
    )
    if foreign:
        print(
            f"  foreign claim ({len(foreign)}) — not verifiable in this repository;\n    check the citing repository: "
            + ", ".join(foreign)
        )
    if local_only:
        where = remote_ref or "HEAD/retained refs"
        print(
            f"  local-only pin ({len(local_only)}): "
            + ", ".join(local_only)
            + f"  [not in {where} — published history cannot verify these]"
        )
    if broken:
        print(f"  BROKEN ({len(broken)}):")
        for b in broken:
            print(f"    {b}")
        return 1
    print(
        "  all cues resolve locally"
        + ("" if remote_ref else "  [no origin remote — publication check skipped]")
    )
    return 0


def self_test() -> int:
    """Firing self-tests for reachable ancestry and foreign attribution."""
    failures: list[str] = []
    if attributed_repo("In simplebroker commit ", 23) is not None:
        failures.append("self-repo marker 'simplebroker' was treated as foreign")
    if attributed_repo("source agent-theory @ `296a7cd`; landed ", 40) is not None:
        failures.append("foreign marker leaked across semicolon clause boundary")
    if attributed_repo("source agent-theory @ ", 22) != "agent-theory":
        failures.append("explicit 'agent-theory @' prefix did not attribute")
    if attributed_repo("source agent-theory @ `296a7cd` (via ", 37) != "agent-theory":
        failures.append(
            "explicit 'agent-theory @ <sha> (via ' prefix did not attribute"
        )

    with tempfile.TemporaryDirectory(prefix="coalesce-check-") as td:
        repo = Path(td)
        git_env = {
            "GIT_AUTHOR_NAME": "Test",
            "GIT_AUTHOR_EMAIL": "test@example.com",
            "GIT_COMMITTER_NAME": "Test",
            "GIT_COMMITTER_EMAIL": "test@example.com",
            "PATH": os.environ.get("PATH", ""),
        }

        def run_git(*args: str) -> str:
            proc = subprocess.run(
                ["git", "-C", str(repo), *args],
                env=git_env,
                capture_output=True,
                text=True,
                check=True,
            )
            return proc.stdout.strip()

        run_git("init", "-b", "main")
        (repo / "README.md").write_text("v1\n", encoding="utf-8")
        run_git("add", "README.md")
        run_git("commit", "-m", "v1")
        v1 = run_git("rev-parse", "--short", "HEAD")

        (repo / "README.md").write_text("v2\n", encoding="utf-8")
        run_git("add", "README.md")
        run_git("commit", "-m", "v2")
        loose = run_git("rev-parse", "--short", "HEAD")
        run_git("reset", "--hard", "HEAD~1")

        sample = f"Published `{v1}` and rebased `{loose}`.\n"
        info = batch_object_info({f"{v1}^{{commit}}", f"{loose}^{{commit}}"}, repo=repo)
        retained = retained_ref_commits(repo=repo)
        _, broken_default, _, _ = classify_sha_claims(
            sample,
            remote_ref=None,
            object_info=info,
            remote_commits=set(),
            retained_commits=retained,
            allow_local_only=False,
        )
        if not broken_default:
            failures.append(
                "unreachable loose commit passed without --allow-local-only"
            )
        _, broken_allowed, local_allowed, _ = classify_sha_claims(
            sample,
            remote_ref=None,
            object_info=info,
            remote_commits=set(),
            retained_commits=retained,
            allow_local_only=True,
        )
        if broken_allowed or local_allowed != [loose]:
            failures.append("--allow-local-only did not classify loose commit cleanly")

    if failures:
        for f in failures:
            print(f"coalesce-check self-test FAIL: {f}")
        return 1
    print("coalesce-check self-test: all reachability and attribution probes pass")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--allow-local-only",
        action="store_true",
        help="allow SHAs that exist only as unreachable local Git objects",
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="run firing self-tests for reachability and attribution",
    )
    args = parser.parse_args(argv)
    if args.self_test:
        return self_test()

    if not STATE.is_file():
        print("coalesce-check: no docs/coalescing.md — nothing to check")
        return 0
    text = STATE.read_text(encoding="utf-8")

    if git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        # History-dependent legs cannot be truthful here; skip loudly.
        # (Adopted from agent-theory @ 0423923 — scaffold contract
        # change: was false BROKEN/exit 1 on shallow clones.)
        cues = sorted(set(CUE_RE.findall(text)) | set(retired_plan_cues()))
        print(
            "coalesce-check: shallow clone detected — SHA-resolution and "
            "retrieval-cue checks SKIPPED (history absent; cues cannot be "
            "verified here). Enforcement requires full history "
            "(fetch-depth: 0)."
        )
        print(f"  retrieval cues found (syntax only, unverified here): {len(cues)}")
        print(f"  lessons dated entries: {count_lesson_entries()}")
        return 0

    retired_cues = retired_plan_cues()
    cues = sorted(set(CUE_RE.findall(text)) | set(retired_cues))
    remote_ref = resolve_remote_ref()
    shas = set(SHA_RE.findall(text)) | {sha for sha, _ in cues}
    object_info = batch_object_info(
        {f"{sha}^{{commit}}" for sha in shas}
        | {
            f"{sha}:{path}"
            for sha, path in cues
            if ".." not in PurePosixPath(path).parts
        }
    )
    remote_commits = reachable_commits(remote_ref)
    retained_commits = retained_ref_commits()
    seen, broken, local_only, foreign = classify_sha_claims(
        text,
        remote_ref=remote_ref,
        object_info=object_info,
        remote_commits=remote_commits,
        retained_commits=retained_commits,
        allow_local_only=args.allow_local_only,
    )
    broken.extend(
        broken_retrieval_cues(
            cues,
            seen=seen,
            local_only=local_only,
            remote_ref=remote_ref,
            object_info=object_info,
            remote_commits=remote_commits,
            retained_commits=retained_commits,
            allow_local_only=args.allow_local_only,
        )
    )
    return report_results(
        claim_count=len(seen),
        cue_count=len(cues),
        retired_cue_count=len(retired_cues),
        lesson_count=count_lesson_entries(),
        remote_ref=remote_ref,
        broken=broken,
        local_only=local_only,
        foreign=foreign,
    )


if __name__ == "__main__":
    sys.exit(main())
